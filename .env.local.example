# ---- StyleShift environment ----
# Copy this file to ".env.local" (which is git-ignored) and fill in real values.
# Pick ONE of the two modes below.

# Mode A — Local dev, no backend: the browser calls Gemini directly.
# (You can also skip this and just paste the key into the app's Settings panel.)
GEMINI_API_KEY=your-gemini-key-here

# Mode B — Secure backend (recommended for public deploys): generation is
# routed through the Supabase Edge Function, so the Gemini key stays on the
# server and is never shipped to the browser. Get these two values from your
# Supabase project → Project Settings → API. When both are set, the app uses
# the backend automatically and no client key is needed.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
